{
  "pluginAlias": "YamahaAlexaBridge",
  "pluginType": "platform",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Yamaha Receiver",
        "required": true
      },
      "ip": {
        "title": "Yamaha Receiver IP",
        "type": "string",
        "format": "ipv4",
        "required": true
      },
      "zone": {
        "title": "Yamaha Zone",
        "type": "string",
        "default": "main",
        "required": true
      },
      "sinricpro": {
        "title": "SinricPro",
        "type": "object",
        "properties": {
          "appKey": {
            "title": "App Key",
            "type": "string",
            "required": true
          },
          "appSecret": {
            "title": "App Secret",
            "type": "string",
            "x-schema-form": { "type": "password" },
            "required": true,
            "minLength": 1
          },
          "deviceId": {
            "title": "Device ID",
            "type": "string",
            "required": true,
            "minLength": 1
          }
        }
      }
    },
    "required": [
      "name",
      "ip",
      "zone",
      "sinricpro"
    ]
  }
}
